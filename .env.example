# このファイルをコピーして .env を作成し、実値を入れる。
#   cp .env.example .env
# .env は .gitignore 済み（コミットされない）。
# `npm run build` 時に scripts/gen-env.mjs が読み取り、
# gitignore された src/env.local.ts を生成して GAS へ push する。

# ---- 共通 ----
AUTH_MODE=oauth                       # oauth | dwd
GCP_PROJECT_ID=                       # 例: meet-attendance-syntopic
# GCP プロジェクトが未存在の場合に mise run setup が自動作成する。
# Workspace 組織配下に作る場合は組織IDを指定（空なら gcloud の組織を自動検出）。
GCP_ORG_ID=                           # 例: 123456789012（省略可）
PUBSUB_TOPIC=meet-events
SLACK_WEBHOOK_URL=
HOSTS=                                # 例: alice@example.com,bob@gmail.com

# 監視対象の会議コード（meet.google.com/【ここ】）。カンマ区切りで複数可。
# 空なら HOSTS が主催する全会議が対象。ハイフン有無は無視して一致判定。
TARGET_MEETING_CODES=                  # 例: aaa-bbbb-ccc,ddd-eeee-fff

# 会議コードごとに Slack 投稿先を切り替える（任意）。
# 形式: <会議コード>=<Webhook URL>,<会議コード>=<Webhook URL>
# 未設定の会議は SLACK_WEBHOOK_URL（デフォルト）に投稿される。
MEETING_SLACK_MAP=                     # 例: aaa-bbbb-ccc=https://hooks.slack.com/services/...

# ---- AUTH_MODE=oauth のとき ----
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ---- AUTH_MODE=dwd のとき (Workspace・キーレス) ----
# SA_CLIENT_EMAIL は mise run setup（gcp-setup.sh）が自動で書き込む。
# 秘密鍵は使わない（IAM Credentials signJwt で署名）。手動設定は不要。
# SA_CLIENT_EMAIL=meet-dwd@<project>.iam.gserviceaccount.com

# ---- push 検証 (任意) ----
# PUSH_SHARED_TOKEN=
# PUBSUB_AUDIENCE=https://script.google.com/macros/s/XXX/exec
